{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ielts-learning-dashboard/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ielts-learning-rose.vercel.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
