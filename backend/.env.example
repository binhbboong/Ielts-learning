# Copy this file to .env for local development. Never commit the real .env.
# In production (Vercel), these are set as Environment Variables instead.

# Postgres connection string. For local dev, points at the Docker Postgres
# container started for testing (see docs/specs/*/Tasks.md for how it's used).
DATABASE_URL=postgresql://postgres:testpass@localhost:5433/ielts_dev

# Same shape, but a separate database so tests never touch dev data.
TEST_DATABASE_URL=postgresql://postgres:testpass@localhost:5433/ielts_test

# Session cookie signing secret. Generate a real random value for any
# non-local environment; rotating it invalidates every outstanding session.
SESSION_SECRET=change-this-to-a-random-value-in-any-real-environment

# Bcrypt hash of the one learner's password. Never store the plaintext
# password anywhere. Local dev placeholder password is "changeme123".
LEARNER_PASSWORD_HASH=$2b$12$ns3JHK/yjPi6xgahjUh9N.j7Ciltjkq0TpnevQxs96BEg1lYbevTa

SESSION_COOKIE_MAX_AGE_DAYS=30
# Local development uses HTTP. Set true in every HTTPS deployment.
SESSION_COOKIE_SECURE=false

# IANA timezone used to decide the learner's local "today" for due dates.
LEARNER_TIMEZONE=Asia/Ho_Chi_Minh

# Shared secret Vercel Cron attaches as `Authorization: Bearer <value>` when it
# calls /api/cron/pregenerate-lessons on schedule. Generate a real random value
# for any non-local environment; leaving it empty rejects every request.
CRON_SECRET=

# Local mode keeps the complete Writing/Speaking workflow runnable without
# external API calls. Its feedback is explicitly labeled as demo feedback.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Set AI_PROVIDER=openai and add OPENAI_API_KEY for genuine AI evaluation.
